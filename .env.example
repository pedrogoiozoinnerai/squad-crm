# ── Banco: projeto `master_data` no Supabase (ref uduvbqngdqbrdrbqartw) ──────────────
# Os três apps (Type, CRM, Dashboard) dividem esta instância, cada um no seu
# schema — CRM e Type têm ambos uma tabela `Lead`, então schema separado não
# é organização, é requisito.
#
# Copie as duas URLs no botão "Connect" do painel do Supabase:
#   DATABASE_URL → "Transaction pooler" (porta 6543) + ?pgbouncer=true
#   DIRECT_URL   → "Direct connection"  (porta 5432), usada só por migrações
#
# DB_SCHEMA: `crm` em produção, `crm_dev` na sua máquina. É o que separa o
# banco de desenvolvimento do de produção dentro do mesmo projeto.
DATABASE_URL="postgresql://postgres.uduvbqngdqbrdrbqartw:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.uduvbqngdqbrdrbqartw:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DB_SCHEMA="crm_dev"

# Domínio de e-mail liberado para criar conta
ALLOWED_EMAIL_DOMAIN="innerai.com"

# Nome exibido no cabeçalho e nos títulos
NEXT_PUBLIC_BRAND_NAME="Squad.com"
TYPE_DATABASE_URL=""

# Schema do funil dentro do master_data (usado após a conversão das consultas).
TYPE_DB_SCHEMA="type_dev"
