# ── Banco: projeto `master_data` no Supabase (ref uduvbqngdqbrdrbqartw) ──────────────
# Os três apps (Type, CRM, Dashboard) dividem esta instância, cada um no seu
# schema — CRM e Type têm ambos uma tabela `Lead`, então schema separado não
# é organização, é requisito.
#
# Copie as duas URLs no botão "Connect" do painel do Supabase:
#   DATABASE_URL → "Transaction pooler" (porta 6543) + ?pgbouncer=true
#   DIRECT_URL   → "Direct connection"  (porta 5432), usada só por migrações
#
# DB_SCHEMA: `crm` em produção, `crm_dev` na sua máquina. É o que separa o
# banco de desenvolvimento do de produção dentro do mesmo projeto.
DATABASE_URL="postgresql://postgres.uduvbqngdqbrdrbqartw:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.uduvbqngdqbrdrbqartw:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DB_SCHEMA="crm_dev"

# Domínio de e-mail liberado para criar conta
ALLOWED_EMAIL_DOMAIN="innerai.com"

# Nome exibido no cabeçalho e nos títulos
NEXT_PUBLIC_BRAND_NAME="Squad.com"
TYPE_DATABASE_URL=""

# Schema do funil dentro do master_data (usado após a conversão das consultas).
TYPE_DB_SCHEMA="type_dev"

# HubSpot — Private App token, só leitura (migração do CRM antigo).
# Settings → Integrations → Private Apps → Create. Escopos necessários:
# crm.objects.contacts.read, crm.objects.deals.read, crm.objects.companies.read,
# crm.objects.owners.read, crm.schemas.deals.read
HUBSPOT_ACCESS_TOKEN=""

# Quem pode criar a PRIMEIRA conta (que vira ADMIN). Obrigatória em produção.
ADMIN_EMAIL="voce@innerai.com"

# ── Entrada com Google Workspace (opcional; sem elas, só e-mail e senha) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# → Web application. Em "Authorized redirect URIs" cadastre EXATAMENTE:
#   http://localhost:3000/api/auth/google/callback
#   https://SEU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Obrigatória em produção: é ela que monta a URL de retorno do OAuth.
NEXT_PUBLIC_APP_URL="https://squad-crm.vercel.app"

# Protege /api/cron/type. Sem ela, em produção a rota recusa: seria um gatilho
# público de escrita no banco. A Vercel envia este valor como Bearer no cron.
CRON_SECRET=""

# ── LiveKit: reuniões por vídeo, gravação e presença ────────────────────────
# LiveKit Cloud → Settings → Keys. As três são obrigatórias juntas: faltando
# qualquer uma, o CRM segue funcionando e só as reuniões por vídeo não abrem.
LIVEKIT_URL="wss://SEU-PROJETO.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
#
# DEPOIS DE PREENCHER, falta um passo que nenhum código faz por você:
# no painel do LiveKit Cloud, em Settings → Webhooks, cadastre a URL
#   https://SEU-DOMINIO/api/livekit/webhook
# com os eventos room_started, room_finished, participant_joined e
# participant_left. Sem isso a presença não é registrada — e é exatamente o
# passo esquecido que deixou 1.028 participações perdidas no CRM de
# referência. A tela /admin/monitoramento avisa quando ele falta.

# ── Agendamento vindo do Funil do Type ──────────────────────────────────────
# Chave compartilhada entre os dois apps. O funil manda em `Authorization:
# Bearer` ao reservar uma vaga; sem ela, /api/agenda/reservar recusa.
#
# Gere um valor longo e aleatório e cole o MESMO nos dois projetos:
#   openssl rand -hex 32
#
# Só a reserva pede chave. Ler a disponibilidade é público: ela devolve dia,
# hora e vagas, nada que já não esteja na tela de quem vai agendar.
FUNIL_API_KEY=""
