{
  "name": "squad-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "clean:icloud": "find .next -name '* [0-9].*' -delete 2>/dev/null || true",
    "predev": "prisma generate && npm run clean:icloud",
    "prebuild": "npm run clean:icloud && npm run test:fusos",
    "prelint": "npm run clean:icloud",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "hubspot:descobrir": "tsx scripts/hubspot-descobrir.ts",
    "vercel:vars": "tsx scripts/vars-vercel.ts",
    "hubspot:importar": "tsx scripts/hubspot-importar.ts",
    "test": "node --import tsx --test testes/*.test.ts",
    "test:fusos": "TZ=UTC npm run test --silent && TZ=America/Sao_Paulo npm run test --silent",
    "verificar:meetsquad": "tsx scripts/verificar-meetsquad.ts",
    "links:faltantes": "tsx scripts/gerar-links-faltantes.ts",
    "senha": "tsx scripts/definir-senha.ts",
    "verificar:jornada": "tsx scripts/verificar-jornada.ts",
    "agenda:gerar": "NODE_OPTIONS=--conditions=react-server tsx scripts/gerar-agenda-producao.ts",
    "sala:teste": "tsx scripts/sala-de-teste.ts",
    "raio-x": "tsx scripts/raio-x.ts",
    "limpar:duplicadas": "tsx scripts/limpar-reunioes-duplicadas.ts",
    "hubspot:atribuicao": "tsx scripts/hubspot-atribuicao.ts",
    "hubspot:utm": "tsx scripts/hubspot-utm-retroativo.ts",
    "hubspot:inventario": "tsx scripts/hubspot-inventario.ts",
    "hubspot:completude": "tsx scripts/hubspot-completude.ts",
    "hubspot:falta": "tsx scripts/hubspot-o-que-falta.ts",
    "esquecer": "NODE_OPTIONS=--conditions=react-server tsx scripts/esquecer-lead.ts",
    "sondar": "tsx scripts/sondar-seguranca.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "livekit-client": "^2.22.3",
    "lucide-react": "^0.545.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
