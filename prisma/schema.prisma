// Prisma schema — CRM (Squad.com)
// Postgres (Supabase) em dev e em produção — projetos distintos, mesma estrutura.
// e apontar DATABASE_URL para o Postgres gerenciado — o mesmo banco do Funil
// do Type, para que o CRM leia os leads do funil sem camada de integração.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Acesso ───────────────────────────────

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Id do owner no HubSpot. É por ele que a importação reencontra o dono de
  /// um negócio quando o e-mail muda ou vem ausente.
  hubspotOwnerId String? @unique

  /// Identidade no Google Workspace. Preenchida no primeiro login por SSO; é
  /// por ela que a conta é reencontrada mesmo se o e-mail mudar de alias.
  googleSub String? @unique

  /// Quando a conta deixou de ser um registro importado e virou gente.
  ///
  /// Antes isso era inferido de `passwordHash == ""`, o que passou a mentir no
  /// instante em que existe login sem senha: quem entra por SSO nunca terá
  /// hash, e continuaria marcado como "a assumir" para sempre.
  claimedAt         DateTime?
  sessions          AuthSession[]
  convitesFeitos    Invite[]           @relation("ConvitesFeitos")
  leads             Lead[]
  deals             Deal[]
  tasks             Task[]
  meetings          Meeting[]
  notes             Note[]
  activities        Activity[]
  sessionTemplates  SessionTemplate[]
  whatsappInstances WhatsappInstance[]
  gravacoesAbertas  RecordingAccess[]
  prompts           AiPrompt[]

  @@index([role])
}

/// Autorização para criar conta.
///
/// O domínio @innerai.com sozinho não basta desde que há operação real dentro:
/// qualquer pessoa com um e-mail do domínio poderia se cadastrar e, pior,
/// assumir a conta importada de um vendedor e ver a carteira dele. Agora um
/// admin libera e-mail por e-mail.
model Invite {
  id        String    @id @default(cuid())
  email     String    @unique
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  createdById String?
  createdBy   User?   @relation("ConvitesFeitos", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

/// Permissão por feature. Mudar quem vê o quê não exige deploy.
model RolePermission {
  id        String   @id @default(cuid())
  role      Role     @unique
  /// Lista de features liberadas, separadas por vírgula.
  features  String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id String @id @default(cuid())

  /// SHA-256 do token, nunca o token.
  ///
  /// O valor em claro só existe no cookie do navegador. Assim, quem obtiver uma
  /// cópia do banco — backup, log de query, dump de suporte — não consegue se
  /// passar por ninguém: teria de inverter o hash.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Erro que aconteceu no servidor.
///
/// Sem isto, um 500 em produção fica invisível até alguém reclamar: o log da
/// Vercel existe, mas ninguém o abre por conta própria. Guardar no banco põe o
/// erro na mesma tela que o time já visita, com o mesmo `digest` que a pessoa
/// vê quando a página quebra — é assim que um relato vira diagnóstico.
model ErrorLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// O mesmo código que aparece na tela de erro para o usuário.
  digest  String?
  message String
  stack   String?
  path    String?
  method  String?
  /// De onde veio: render de página, server action, route handler.
  origem  String?

  @@index([createdAt])
  @@index([digest])
}

/// Balde de limite de taxa: uma linha por rota, por quem pede, por janela.
///
/// Em banco pela mesma razão de `LoginAttempt`: serverless não compartilha
/// memória, e um contador em processo protege só a instância que atendeu.
///
/// A janela entra na CHAVE, não numa coluna de data. Assim a virada é
/// automática — a janela seguinte é outra linha — e não há relógio para
/// comparar nem contador para zerar.
model RateLimit {
  chave    String   @id
  contagem Int      @default(1)
  expiraEm DateTime

  @@index([expiraEm])
}

/// Tentativa de login, para travar força bruta.
///
/// Em banco e não em memória porque a aplicação roda serverless: cada requisição
/// pode cair num processo diferente, e um contador em memória protegeria apenas
/// a instância que por acaso atendeu.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  sucesso   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────── Leads ────────────────────────────────

enum LeadStatus {
  INCOMPLETE // recém-captado, falta qualificação
  COMPLETE // dados completos, pronto pra contato
  CONVERTED
  LOST
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  email         String?
  phone         String?
  company       String?
  jobTitle      String?
  segment       String?
  revenueRange  String?
  collaborators String?
  score         String? // A–E
  status        LeadStatus @default(INCOMPLETE)
  notes         String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Atribuição (espelha o funil do Type)
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  /// Link rastreado enviado ao lead + quantas vezes foi aberto.
  trackedLink   String?
  linkClicks    Int       @default(0)
  lastLinkClick DateTime?

  // Ponte com o Funil do Type — preenchido pelo import
  typeLeadId    String? @unique
  typeSessionId String? @unique

  /// Ponte com o HubSpot. Sem ela a importação não é repetível: rodar de novo
  /// duplicaria tudo, e não haveria como reimportar só o que mudou.
  hubspotContactId String? @unique

  deals        Deal[]
  tasks        Task[]
  meetings     Meeting[]
  noteEntries  Note[]
  activities   Activity[]
  meetingSeats MeetingAttendee[]
  outbox       SendQueue[]

  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

// ───────────────────────────── Pipeline ───────────────────────────────

model Stage {
  id    String @id @default(cuid())
  key   String @unique
  name  String
  order Int
  color String

  /// Papel que opera esta etapa (SDR, closer, CS…). Null = qualquer um.
  targetRole String?

  deals       Deal[]
  automations TaskAutomation[]

  @@index([order])
}

/// Motivos de perda padronizados — sem isso não dá para analisar perda.
model LossReason {
  id         String  @id @default(cuid())
  name       String  @unique
  orderIndex Int     @default(0)
  active     Boolean @default(true)

  deals Deal[]

  @@index([orderIndex])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

/// Presença do lead na demo agendada.
enum Attendance {
  AGENDADO
  PARTICIPOU
  NAO_COMPARECEU
}

/// Etapa obrigatória antes de marcar o negócio como ganho.
enum MentorshipStatus {
  PENDENTE
  AGENDADA
  CONCLUIDA
}

model Deal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code          String  @unique
  /// Ver Lead.hubspotContactId — mesma razão, do lado do negócio.
  hubspotDealId String? @unique

  /// Um lead pode ter vários negócios: a mesma pessoa compra de novo,
  /// renova, faz upsell. Era 1:1 enquanto os dados eram nossos; no histórico
  /// real do HubSpot 10% dos contatos têm mais de um, e recortar isso
  /// subcontaria conversão, receita e ciclo de venda para sempre.
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  status       DealStatus  @default(OPEN)
  /// Sempre em CENTAVOS. Float em dinheiro acumula erro de arredondamento.
  valueCents   Int         @default(0)
  product      String?
  probability  Int         @default(20)
  expectedAt   DateTime?
  /// Texto livre complementar; o motivo estruturado é `lossReason`.
  lostNote     String?
  lossReasonId String?
  lossReason   LossReason? @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  wonAt        DateTime?
  lostAt       DateTime?

  attendance       Attendance       @default(AGENDADO)
  paymentMethod    String?
  paymentLink      String?
  mentorshipStatus MentorshipStatus @default(PENDENTE)
  mentorshipAt     DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  /// Alguém corrigiu a presença à mão. A partir daí a derivação não toca
  /// mais nesta linha — o número do vendedor vence o do sistema.
  attendanceManual Boolean   @default(false)
  attendanceAt     DateTime?

  meetings    Meeting[]
  tasks       Task[]
  history     DealStageHistory[]
  noteEntries Note[]
  activities  Activity[]

  @@index([leadId])
  @@index([stageId])
  @@index([ownerId])
  @@index([status])
  @@index([lossReasonId])
}

model DealStageHistory {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage String?
  toStage   String
  movedBy   String?
  createdAt DateTime @default(now())

  @@index([dealId])
}

// ─────────────────────────────── Tarefas ──────────────────────────────

enum TaskStatus {
  PENDING
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// Modelo de tarefa reaproveitável (assunto, prioridade, mensagem pronta).
model TaskTemplate {
  id             String       @id @default(cuid())
  name           String
  description    String?
  type           String       @default("follow_up")
  priority       TaskPriority @default(MEDIUM)
  /// Mensagem sugerida ao lead quando a tarefa é criada.
  messageText    String?
  meetingEnabled Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  tasks       Task[]
  automations TaskAutomation[]
}

/// Ao entrar numa etapa, cria a tarefa do template automaticamente.
model TaskAutomation {
  id            String       @id @default(cuid())
  templateId    String
  template      TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  targetStageId String
  targetStage   Stage        @relation(fields: [targetStageId], references: [id], onDelete: Cascade)
  /// Prazo da tarefa = entrada na etapa + este número de dias.
  dueInDays     Int          @default(1)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@unique([templateId, targetStageId])
  @@index([targetStageId])
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ponte com a tarefa de origem no HubSpot — ver Lead.hubspotContactId.
  hubspotTaskId String? @unique

  subject     String
  /// Detalhe livre: no HubSpot é o corpo da tarefa, e sem ele o vendedor lê só
  /// o assunto e não sabe o que foi combinado.
  description String?
  type        String       @default("follow_up")
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  templateId String?
  template   TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Marca as tarefas nascidas de automação, para não parecerem manuais.
  automated  Boolean       @default(false)

  @@index([ownerId, status])
  @@index([dueAt])
  @@index([dealId])
  @@index([leadId])
  @@index([templateId])
}

// ───────────────────── Sessões recorrentes ────────────────────────────

enum Horizonte {
  /// Até o último dia do mês corrente.
  FIM_DO_MES
  /// Um número fixo de dias à frente (`horizonDias`).
  DIAS
}

/// Série recorrente ("toda terça 10h"). Não é um evento — é a regra.
model SessionTemplate {
  id          String   @id @default(cuid())
  name        String
  /// Dias da semana em que ocorre: 1=segunda … 7=domingo, separados por vírgula.
  weekdays    String
  /// Horários do dia, "HH:MM" separados por vírgula: "08:00,09:00,…,20:00".
  ///
  /// Lista, e não um horário só, desde que a agenda do funil passou a abrir um
  /// horário por hora. Mesma convenção de `weekdays`, no mesmo model — e o
  /// nome no plural porque `time` guardando lista é a armadilha que
  /// `horizonDays` já foi.
  times       String
  durationMin Int      @default(45)
  capacity    Int      @default(20)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  /// Fuso em que `weekdays` e `times` são lidos.
  ///
  /// Sem ele, materializar no runner da Vercel — que roda em UTC — moveria
  /// toda sessão em três horas. É o mesmo defeito que a grade já teve.
  timezone String @default("America/Sao_Paulo")

  /// Até onde o materializador enche a agenda.
  ///
  /// `FIM_DO_MES` é o que a operação usa: a agenda vai até o último dia do mês
  /// corrente e para. É estrito de propósito — no dia 30 sobra um dia, e quem
  /// precisa ver isso chegando é o time, pelo monitoramento, não o lead.
  ///
  /// `DIAS` mantém o comportamento antigo para uma série pontual, usando
  /// `horizonDias`.
  horizonte   Horizonte @default(FIM_DO_MES)
  horizonDias Int       @default(28)

  /// A partir de quando a série vale, e até quando. Nulo = sem limite.
  startsOn DateTime?
  endsOn   DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  meetings Meeting[]

  @@index([ownerId])
}

// ────────────────────────────── Calendário ────────────────────────────

enum MeetingType {
  GROUP
  ONE_ON_ONE
}

enum MeetingStatus {
  SCHEDULED
  DONE
  NO_SHOW
  CANCELED
}

model Meeting {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title    String
  startsAt DateTime
  endsAt   DateTime
  type     MeetingType   @default(ONE_ON_ONE)
  status   MeetingStatus @default(SCHEDULED)

  /// Reserva correspondente no Cal.com.
  ///
  /// É por ela que a sincronização reencontra a reunião quando o lead remarca
  /// ou desmarca. Sem isso, cancelar no Cal deixaria uma reunião fantasma na
  /// agenda do vendedor, e remarcar criaria uma segunda em vez de mover a
  /// primeira. Único, porque uma reserva vira uma reunião só.
  calBookingUid String? @unique

  /// Onde a reunião acontece, como o Cal.com informou (link, telefone, sala).
  location String?

  /// Ponte com a reunião de origem no HubSpot.
  hubspotMeetingId String? @unique

  // Reservado pro projeto 3 (Meet com LiveKit)
  roomId String?

  /// O link da reunião — o que se manda para quem não tem conta nem convite.
  ///
  /// Existe porque nem toda reunião tem lead: uma call interna, um convidado
  /// que não está no funil, uma conversa marcada na hora. Sem ele, a única
  /// porta para quem está de fora era o convite do roster, que exige um lead.
  ///
  /// 32 bytes aleatórios, único, e NUNCA o `id` da reunião: id é adivinhável a
  /// partir de outro, e daria a sala de qualquer reunião a quem tivesse um.
  /// Quem entra por aqui é "convidado" — aparece em `Presence`, que é a
  /// verdade crua, e não vira inscrito de ninguém.
  guestToken String? @unique

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// A qual negócio esta reunião pertence.
  ///
  /// Sem isto não há como dizer QUAL reunião decide o `attendance` de QUAL
  /// negócio — a reunião só conhece o lead, e um lead pode ter vários. Era por
  /// isso que `Deal.attendance` continuava sendo digitado à mão.
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  /// Só em GROUP. Nulo = sem limite, que é o caso de toda 1:1.
  capacity Int?

  /// A série que gerou esta ocorrência, quando veio de um template.
  templateId String?
  template   SessionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  roomEvents RoomEvent[]
  presences  Presence[]
  attendees  MeetingAttendee[]
  mensagens  RoomMessage[]
  gravacoes  Recording[]
  notes      Note[]
  activities Activity[]

  @@unique([templateId, startsAt])
  @@index([type, status, startsAt])
  @@index([startsAt])
  @@index([ownerId, startsAt])
  @@index([leadId])
  @@index([templateId])
}

// ──────────────────────── Anotações e atividades ──────────────────────

model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  /// Anotação vinda do HubSpot; nula quando escrita aqui.
  hubspotNoteId String? @unique

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// A anotação sobre a SESSÃO, e não sobre uma pessoa.
  ///
  /// Faltava onde cair: uma sessão coletiva tem vinte leads, e "a objeção de
  /// preço apareceu três vezes hoje" não é anotação de nenhum deles. Sem esta
  /// coluna, o que o closer aprende na call não tinha lugar nenhum.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dealId])
  @@index([authorId])
  @@index([meetingId, createdAt])
}

enum ActivityKind {
  LEAD_CREATED
  LEAD_UPDATED
  DEAL_CREATED
  DEAL_UPDATED
  STAGE_CHANGED
  DEAL_WON
  DEAL_LOST
  TASK_CREATED
  TASK_DONE
  NOTE_ADDED
  MEETING_SCHEDULED
  IMPORTED
}

/// Linha do tempo unificada do lead/negócio.
model Activity {
  id        String       @id @default(cuid())
  kind      ActivityKind
  title     String
  detail    String?
  createdAt DateTime     @default(now())

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// A qual sessão o fato pertence, quando pertence a uma.
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([authorId])
  @@index([dealId, createdAt])
  @@index([meetingId, createdAt])
}

// ────────────────────────── Cases de sucesso ──────────────────────────

/// Cases usados como prova social, sugeridos pelo setor do lead.
model Case {
  id        String   @id @default(cuid())
  title     String
  client    String
  segment   String
  highlight String // métrica de destaque, ex.: "200x"
  metric    String // o que a métrica mede, ex.: "Redução de Preço"
  summary   String
  link      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([segment])
}

// ──────────────── WhatsApp: instâncias e fila de envio ────────────────

enum SendStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Uma instância de WhatsApp por vendedor, pareada por QR.
model WhatsappInstance {
  id           String    @id @default(cuid())
  instanceName String    @unique
  phoneNumber  String?
  provider     String    @default("evolution")
  status       String    @default("disconnected") // disconnected | pairing | connected
  isDefault    Boolean   @default(false)
  active       Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  queue SendQueue[]

  @@index([ownerId])
}

/// Padrão outbox: a UI insere aqui, um worker entrega e marca o resultado.
/// Humano e IA usam a MESMA fila, diferenciados por `fromType`.
model SendQueue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  instanceId String
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  content     String
  messageType String     @default("text") // text | audio | image | template
  mediaUrl    String?
  fromType    String     @default("human") // human | ai
  /// Menor número sai primeiro — confirmação de reunião fura a fila.
  priority    Int        @default(5)
  status      SendStatus @default(PENDING)
  attempts    Int        @default(0)
  lastError   String?
  sentAt      DateTime?

  @@index([status, priority, createdAt])
  @@index([leadId])
  @@index([instanceId])
}

// ── LiveKit: presença em três camadas ────────────────────────────────────────
//
// 1. `RoomEvent` guarda o que o LiveKit contou, cru e sem interpretação.
// 2. `Presence` é DERIVADA dos eventos por reconciliação idempotente.
// 3. A tela de monitoramento mostra quando a camada 1 parou de chegar.
//
// A razão de ser: no CRM de referência a presença é escrita direto pelo
// webhook, o webhook precisa ser configurado à mão no painel do LiveKit e
// ninguém verifica se foi. São 1.028 participações esperando um botão manual
// de reprocessar. Evento cru + derivação idempotente conserta sozinho quando
// os dados voltam; estado escrito direto não tem como se recuperar.

/// Evento cru de sala. Só o webhook escreve aqui, e nada além de INSERT.
model RoomEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Id do evento no LiveKit. Único porque ele REENTREGA quando não recebe
  /// 200 — sem isso a mesma entrada contaria duas vezes e inflaria o tempo
  /// de permanência.
  livekitId String @unique

  /// room_started | room_finished | participant_joined | participant_left
  type String
  room String

  /// Quando aconteceu no LiveKit — não quando chegou aqui. A diferença
  /// importa: uma reentrega de ontem tem que somar no tempo de ontem.
  at DateTime

  /// "u_<userId>" ou "l_<leadId>", como o token emitiu. Nulo em room_started
  /// e room_finished.
  identity String?
  name     String?

  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([room, at])
  @@index([meetingId])
  @@index([type, at])
  @@index([createdAt])
}

/// Uma mensagem do chat da sala.
///
/// O chat nasceu só no canal de dados do LiveKit, e o canal de dados não tem
/// memória: fechar o painel desmontava a lista, recarregar a página zerava a
/// conversa, e quem entrava no meio da sessão via um chat vazio enquanto as
/// outras trinta pessoas conversavam. Numa sessão de apresentação, o chat é
/// onde a objeção aparece — perder isso é perder a objeção.
///
/// O canal de dados CONTINUA sendo por onde a mensagem chega (é instantâneo e
/// não depende de nós); isto aqui é a memória ao lado. Quem manda escreve nos
/// dois, e quem entra lê o histórico daqui antes de começar a ouvir o canal.
/// O que a mensagem É.
///
/// `OFERTA` é o botão de compra que o closer manda no fim do pitch: mesma
/// conversa, mesmo canal, mas a tela desenha um botão em vez de uma frase — e
/// é o único momento em que o chat tem uma ação dentro.
enum RoomMessageKind {
  TEXTO
  OFERTA
}

model RoomMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tipo RoomMessageKind @default(TEXTO)

  /// Para onde o botão leva. Só em `OFERTA`.
  ///
  /// Guardado separado do texto porque é o que precisa ser validado antes de
  /// virar um link clicável na tela de trinta pessoas: `javascript:` num chat
  /// aberto seria um convite.
  url String?

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// A mesma identidade do LiveKit (`u_…`, `l_…`, `g_…`) — é ela que liga a
  /// mensagem a `Presence` e ao roster, sem depender do nome digitado.
  identity String
  /// Como a pessoa aparecia na sala quando escreveu. Guardado junto, e não
  /// buscado depois: um convidado não existe em lugar nenhum além da sala.
  autor    String

  texto String

  @@index([meetingId, createdAt])
}

/// Presença consolidada de um participante numa reunião. Recalculável: apagar
/// tudo aqui e rodar a reconciliação de novo devolve exatamente o mesmo.
model Presence {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  identity String
  name     String?

  /// Preenchidos a partir do prefixo da identidade. Um dos dois, nunca ambos.
  userId String?
  leadId String?

  /// Primeira entrada e última saída.
  joinedAt DateTime
  leftAt   DateTime?

  /// Tempo somado de permanência. Soma de TODOS os pares entrada/saída:
  /// queda de conexão no meio da call é normal, e contar só o primeiro par
  /// subestimaria quem ficou até o fim.
  seconds Int @default(0)

  @@unique([meetingId, identity])
  @@index([meetingId])
  @@index([leadId])
}

/// Configuração da plataforma. Uma linha só — o id fixo garante isso.
model Config {
  id        String   @id @default("unica")
  updatedAt DateTime @updatedAt

  /// Quando um participante "esteve" na reunião.
  ///
  /// São regra de negócio, não constante: o que conta como presença numa demo
  /// de 20 minutos não é o que conta numa mentoria de 2 horas. Os dois
  /// critérios valem juntos — precisa passar nos dois.
  presencaMinutos    Int @default(5)
  presencaPercentual Int @default(0)

  /// Até onde o funil do Type já foi espelhado.
  ///
  /// Antes a leitura era "as 500 mais recentes", relidas inteiras a cada dez
  /// minutos. Dois defeitos nisso: reprocessava 72 mil linhas por dia para
  /// ~1.000 leads novos, e — o grave — numa rajada de mais de 500 leads em dez
  /// minutos os excedentes saíam da janela e NUNCA voltavam. Sem erro, sem
  /// log, sem fila: o lead simplesmente não existia no CRM.
  ///
  /// A marca é sobre `updatedAt`, não `createdAt`: o espelho também precisa
  /// pegar quem já existia e MUDOU — remarcou, cancelou, agendou depois.
  funilSincronizadoAte DateTime?

  /// Por quanto tempo o vídeo fica.
  ///
  /// São os números mais caros do schema e os únicos que ninguém pode escolher
  /// por conta: guardar a conversa de um cliente é decisão de quem responde
  /// por privacidade, não de quem escreve a migração. Os padrões abaixo são
  /// PROPOSTA — 0 desliga a retenção e guarda para sempre, que é o que vale
  /// enquanto o prazo não for decidido.
  ///
  /// A transcrição sobrevive ao vídeo de propósito: ela é o que sustenta o
  /// resumo e a auditoria depois que o arquivo de 550 MB já foi embora.
  retencaoVideoDias       Int @default(0)
  retencaoTranscricaoDias Int @default(0)
}

// ── MeetSquad: o roster da reunião ───────────────────────────────────────────

enum AttendeeStatus {
  INSCRITO
  CONFIRMADO
  CANCELADO
  LISTA_ESPERA
}

enum AttendeeSource {
  INSCRICAO
  CONVITE
  IMPORTADO
  AUTOMATICO
}

/// Quem está numa reunião. Serve a 1:1 (uma linha) e a coletiva (N linhas).
///
/// O convite não é um modelo à parte: ele É esta linha. O `inviteToken` na URL
/// é o que identifica o lead na sala, e é por isso que o `meetingId` cru nunca
/// pode ir num link — ele é adivinhável a partir de outro, e daria a sala de
/// qualquer reunião a qualquer um.
model MeetingAttendee {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status AttendeeStatus @default(INSCRITO)
  source AttendeeSource @default(INSCRICAO)

  /// 32 bytes aleatórios. `cuid` não serve: é sequencial, e quem tem um
  /// convite conseguiria adivinhar os vizinhos.
  inviteToken   String    @unique
  /// Quantas vezes esta inscrição já mudou de horário.
  ///
  /// Vira o `SEQUENCE` do convite de calendário, e é ele que faz o compromisso
  /// ser ATUALIZADO no aparelho do lead em vez de virar um segundo: o
  /// calendário só aceita a atualização se o número for maior que o que ele já
  /// tem. Sem isso, remarcar deixava o horário velho no celular da pessoa.
  versao        Int       @default(0)
  invitedAt     DateTime?
  firstOpenedAt DateTime?
  openCount     Int       @default(0)
  confirmedAt   DateTime?

  /// Consentimento de gravação, colhido na entrada. Sem ele a sala não grava.
  consentAt DateTime?
  consentIp String?

  /// DERIVADOS da reconciliação — nunca escritos à mão nem por formulário.
  joinedAt     DateTime?
  leftAt       DateTime?
  joinCount    Int       @default(0)
  totalSeconds Int       @default(0)
  attended     Boolean   @default(false)

  /// A regra que produziu `attended`. Sem isto, mudar o mínimo de 5 para 8
  /// minutos reescreveria a história e ninguém saberia qual número era qual.
  regraMinutos Int?

  @@unique([meetingId, leadId])
  @@index([leadId])
  @@index([meetingId, status])
}

// ── Gravação, transcrição e análise da call ──────────────────────────────────
//
// O que decide coluna × jsonb aqui: **coluna** quando o valor é filtrado,
// ordenado, somado ou aparece numa lista; **jsonb** quando só é desenhado no
// detalhe de UMA call. Um `veredicto` em jsonb transformaria "quem está de
// freestyle esta semana?" numa varredura de tabela.

/// Em que ponto a gravação está.
///
/// Os nomes são nossos, não os do LiveKit (`EGRESS_STARTING`, `EGRESS_ACTIVE`,
/// …): o egress é um detalhe de fornecedor, e esta coluna é lida pela tela.
/// O de-para vive em `lib/gravacao`, com o **avanço monotônico** — o LiveKit
/// não garante ordem de entrega, e um `egress_started` que chega depois do
/// `egress_ended` faria uma gravação pronta voltar a "gravando".
enum RecordingStatus {
  PENDENTE
  GRAVANDO
  PROCESSANDO
  COMPLETA
  FALHOU
  ABORTADA
  /// Apagada pela retenção. A linha FICA: é ela que explica por que não há
  /// vídeo, e sem ela "sumiu" e "nunca gravou" viram a mesma tela.
  APAGADA
}

/// O arquivo de uma call.
///
/// Derivado dos eventos de egress do LiveKit, nunca escrito à mão. Até aqui o
/// webhook recebia arquivo, tamanho e duração e JOGAVA FORA, achatando tudo num
/// `RoomEvent` com o `egressId` no campo `name`.
model Recording {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// Id do egress no LiveKit. Único: é a chave de reconciliação, e é por ela
  /// que o evento reentregue encontra a linha em vez de criar uma segunda.
  egressId String @unique

  status RecordingStatus @default(PENDENTE)

  /// Caminho do arquivo DENTRO do bucket. Nunca uma URL: a URL é assinada na
  /// hora de assistir e vale minutos — guardá-la seria guardar uma chave.
  caminho String?

  /// `BigInt` porque `int4` estoura em 2,1 GB e uma mentoria de duas horas
  /// passa disso. Nunca atravessa para o cliente como está: `Number()` na
  /// camada de consulta, senão o `JSON.stringify` do Server Component quebra.
  bytes BigInt?

  /// A duração MEDIDA do arquivo — não a agendada. É ela que diz que a call de
  /// 45 minutos durou 71.
  duracaoSegundos Int?

  iniciadaEm  DateTime?
  terminadaEm DateTime?

  /// O que o LiveKit disse quando falhou. Some da tela, fica no registro.
  erro String?

  /// O último `egressInfo` inteiro. Sem ele, "falhou" é beco sem saída — e a
  /// forma desse JSON muda do lado deles sem avisar.
  bruto Json?

  /// Quando a retenção apagou o arquivo do bucket.
  apagadaEm DateTime?

  transcript Transcript?
  acessos    RecordingAccess[]

  @@index([meetingId])
  @@index([status, createdAt])
}

/// Quem pediu para assistir, e quando.
///
/// A gravação é do TIME, não do dono da call: qualquer pessoa do comercial
/// abre a call de qualquer outra. Isso é a decisão certa para vender e é
/// exatamente o que faz este registro ser obrigatório — é a primeira coisa que
/// se pergunta quando alguém quer saber quem ouviu a conversa de um cliente.
model RecordingAccess {
  id  String   @id @default(cuid())
  em  DateTime @default(now())

  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ip String?

  @@index([recordingId, em])
  @@index([userId, em])
}

/// O que foi dito.
model Transcript {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  recordingId String    @unique
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  /// Id do pedido no provedor (`request_id` da Deepgram). Único: é por ele que
  /// o retorno assíncrono reencontra o trabalho, e é o que impede um callback
  /// repetido de gravar duas vezes.
  externoId String? @unique

  /// O texto corrido. **Coluna**, não jsonb: é ele que entra no prompt, e um
  /// `->>'texto'` numa call de 60 mil caracteres é caro à toa.
  texto String

  /// Trechos com início, fim e falante. Só desenhado no detalhe de uma call.
  segmentos Json?

  /// De-para de falante para pessoa, quando dá. Numa sala de vinte não dá — e
  /// prometer nome quando não se sabe é pior que não prometer.
  falantes Json?

  idioma  String?
  modelo  String?

  analise CallAnalysis?
}

/// O prompt de análise, versionado.
///
/// **Nunca `UPDATE`**: editar por cima apagaria a régua pela qual as calls
/// antigas foram julgadas, e duas calls com a mesma nota passariam a ter sido
/// medidas por textos diferentes sem que nada registrasse isso.
///
/// `corpo` é **só a rubrica**. O contrato de saída é anexado pelo código, a
/// partir do Zod em `lib/analise` — o operador não alcança o formato. É o
/// conserto, por construção, do erro do CRM de referência: lá o prompt de
/// 13.605 caracteres pedia dezenas de campos e o schema de saída aceitava
/// cinco, então a maior parte da análise era gerada e descartada.
model AiPrompt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Por ora só `AUDITORIA`. String e não enum porque a próxima régua
  /// (objeções, roleplay) não deveria exigir migração.
  tipo   String
  versao Int
  ativo  Boolean @default(false)
  corpo  String

  autorId String?
  autor   User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)

  analises CallAnalysis[]

  @@unique([tipo, versao])
  @@index([tipo, ativo])
}

/// A auditoria da call contra o playbook.
model CallAnalysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  transcriptId String     @unique
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  promptId String?
  prompt   AiPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)

  modelo String?

  // ── Colunas: o que uma LISTA pergunta ──────────────────────────────────
  /// O que aconteceu na call. A primeira coisa que o closer lê.
  resumo       String
  /// Uma linha: "seguiu o playbook", "improvisou o fechamento".
  veredicto    String?
  aderenciaPct Int?
  notaGeral    Int?
  engajamento  Int?
  blocosOk     Int?
  blocosTotal  Int?
  errosCriticos Int  @default(0)
  proibidasCount Int @default(0)
  /// Em que treinar. `String[]` porque a pergunta é "quem precisa treinar
  /// fechamento?" — e isso é um `has`, não um `LIKE` em jsonb.
  roleplayFoco String[]

  // ── jsonb: o que só o DETALHE desenha ──────────────────────────────────
  blocos        Json?
  erros         Json?
  vocabulario   Json?
  objecoes      Json?
  scorecard     Json?
  insights      Json?
  proximosPassos Json?

  /// A resposta crua do modelo. Sem ela, "falhou na validação" é beco sem
  /// saída: não dá para ver o que ele respondeu nem consertar o schema.
  bruto Json?

  /// Quando a retenção trocou as citações por marcador. Os números ficam.
  redigidaEm DateTime?

  @@index([createdAt])
  @@index([veredicto])
}

/// Trabalho assíncrono, com arrendamento.
///
/// A fila é **semeada por derivação, não por empurrão**: o webhook não cria
/// job nenhum. O cron pergunta ao banco "que gravação COMPLETA não tem
/// transcrição?". É a forma de `reconciliarPresencas`, e pelo mesmo motivo —
/// callback perdido, webhook que não chegou, deploy no meio da call: tudo se
/// conserta na execução seguinte, sem ninguém reenfileirar à mão.
model AiJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Chave de NEGÓCIO (`TRANSCREVER:<recordingId>`), não um id aleatório. É o
  /// que faz dois crons sobrepostos criarem um trabalho, e não dois.
  chave String @unique

  etapa  String
  estado String @default("PENDENTE")

  /// Id do trabalho no provedor — `request_id` da Deepgram, id do lote da
  /// Anthropic. É por ele que a execução seguinte descobre se já ficou pronto.
  externoId String?

  tentativas Int @default(0)
  /// Arrendamento: até quando este trabalho é de quem o pegou. Uma execução
  /// que morre no meio devolve o trabalho sozinha quando o prazo vence.
  arrendadoAte     DateTime?
  proximaTentativaEm DateTime?
  erro             String?

  @@index([estado, proximaTentativaEm])
  @@index([etapa, estado])
}
